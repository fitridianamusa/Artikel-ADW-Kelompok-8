        "# ============================================\n",
        "# 5.2 PERBANDINGAN KANDIDAT MODEL GARCH\n",
        "# Mean Model: AR(1)\n",
        "# ============================================\n",
        "\n",
        "kandidat_garch = {\n",
        "    \"GARCH(1,1)\": (1, 1),\n",
        "    \"GARCH(1,2)\": (1, 2),\n",
        "    \"GARCH(2,1)\": (2, 1),\n",
        "    \"GARCH(2,2)\": (2, 2)\n",
        "}\n",
        "\n",
        "hasil_garch_kandidat = {}\n",
        "hasil_perbandingan = []\n",
        "\n",
        "for nama, (p, q) in kandidat_garch.items():\n",
        "\n",
        "    model = arch_model(\n",
        "        r_train,\n",
        "        mean=\"AR\",\n",
        "        lags=1,\n",
        "        vol=\"GARCH\",\n",
        "        p=p,\n",
        "        q=q,\n",
        "        dist=\"normal\",\n",
        "        rescale=True\n",
        "    )\n",
        "\n",
        "    hasil = model.fit(disp=\"off\")\n",
        "\n",
        "    hasil_garch_kandidat[nama] = hasil\n",
        "\n",
        "    # Menghitung persistensi volatilitas\n",
        "    alpha_sum = sum(\n",
        "        hasil.params.get(f\"alpha[{i}]\", 0)\n",
        "        for i in range(1, p + 1)\n",
        "    )\n",
        "\n",
        "    beta_sum = sum(\n",
        "        hasil.params.get(f\"beta[{i}]\", 0)\n",
        "        for i in range(1, q + 1)\n",
        "    )\n",
        "\n",
        "    hasil_perbandingan.append({\n",
        "        \"Model\": nama,\n",
        "        \"AIC\": hasil.aic,\n",
        "        \"BIC\": hasil.bic,\n",
        "        \"Log Likelihood\": hasil.loglikelihood,\n",
        "        \"Persistensi\": alpha_sum + beta_sum,\n",
        "        \"Konvergensi\": hasil.convergence_flag\n",
        "    })\n",
        "\n",
        "tabel_garch = pd.DataFrame(hasil_perbandingan)\n",
        "\n",
        "print(\"PERBANDINGAN KANDIDAT MODEL GARCH\")\n",
        "display(tabel_garch.round(5))"

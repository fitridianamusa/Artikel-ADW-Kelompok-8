      "source": [
        "# ============================================\n",
        "# 12A. PENGGABUNGAN HASIL PREDIKSI TIGA MODEL\n",
        "# ============================================\n",
        "\n",
        "# 1. Hasil prediksi GARCH\n",
        "garch_compare = tabel_forecast[\n",
        "    [\"Tanggal\", \"Harga_Aktual\", \"Prediksi_Harga\"]\n",
        "].copy()\n",
        "\n",
        "garch_compare = garch_compare.rename(\n",
        "    columns={\n",
        "        \"Prediksi_Harga\": \"Prediksi_GARCH\"\n",
        "    }\n",
        ")\n",
        "\n",
        "\n",
        "# 2. Hasil prediksi LSTM\n",
        "lstm_compare = hasil_lstm[\n",
        "    [\"Tanggal\", \"Prediksi_Harga\"]\n",
        "].copy()\n",
        "\n",
        "lstm_compare = lstm_compare.rename(\n",
        "    columns={\n",
        "        \"Prediksi_Harga\": \"Prediksi_LSTM\"\n",
        "    }\n",
        ")\n",
        "\n",
        "\n",
        "# 3. Hasil prediksi Hybrid\n",
        "hybrid_compare = hasil_evaluasi_hybrid[\n",
        "    [\"Tanggal\", \"Prediksi_Harga_Hybrid\"]\n",
        "].copy()\n",
        "\n",
        "\n",
        "# Menggabungkan ketiga hasil prediksi\n",
        "perbandingan_prediksi = garch_compare.merge(\n",
        "    lstm_compare,\n",
        "    on=\"Tanggal\",\n",
        "    how=\"inner\"\n",
        ")\n",
        "\n",
        "perbandingan_prediksi = perbandingan_prediksi.merge(\n",
        "    hybrid_compare,\n",
        "    on=\"Tanggal\",\n",
        "    how=\"inner\"\n",
        ")\n",
        "\n",
        "# Mengurutkan berdasarkan tanggal\n",
        "perbandingan_prediksi = perbandingan_prediksi.sort_values(\n",
        "    \"Tanggal\"\n",
        ").reset_index(drop=True)\n",
        "\n",
        "# Memeriksa hasil penggabungan\n",
        "print(\"HASIL PENGGABUNGAN PREDIKSI TIGA MODEL\")\n",
        "print(\"Jumlah observasi:\", len(perbandingan_prediksi))\n",
        "\n",

        "# ============================================\n",
        "# 12B. EVALUASI PERBANDINGAN TIGA MODEL\n",
        "# ============================================\n",
        "\n",
        "aktual = perbandingan_prediksi[\n",
        "    \"Harga_Aktual\"\n",
        "].to_numpy()\n",
        "\n",
        "prediksi_garch = perbandingan_prediksi[\n",
        "    \"Prediksi_GARCH\"\n",
        "].to_numpy()\n",
        "\n",
        "prediksi_lstm = perbandingan_prediksi[\n",
        "    \"Prediksi_LSTM\"\n",
        "].to_numpy()\n",
        "\n",
        "prediksi_hybrid = perbandingan_prediksi[\n",
        "    \"Prediksi_Harga_Hybrid\"\n",
        "].to_numpy()\n",
        "\n",
        "\n",
        "# Fungsi evaluasi\n",
        "def hitung_metrik(aktual, prediksi):\n",
        "\n",
        "    rmse = np.sqrt(\n",
        "        np.mean((aktual - prediksi) ** 2)\n",
        "    )\n",
        "\n",
        "    mae = np.mean(\n",
        "        np.abs(aktual - prediksi)\n",
        "    )\n",
        "\n",
        "    mape = np.mean(\n",
        "        np.abs((aktual - prediksi) / aktual)\n",
        "    ) * 100\n",
        "\n",
        "    return rmse, mae, mape\n",
        "\n",
        "\n",
        "# Menghitung evaluasi setiap model\n",
        "hasil_garch = hitung_metrik(aktual, prediksi_garch)\n",
        "hasil_lstm = hitung_metrik(aktual, prediksi_lstm)\n",
        "hasil_hybrid = hitung_metrik(aktual, prediksi_hybrid)\n",
        "\n",
        "\n",
        "# Membentuk tabel perbandingan\n",
        "tabel_perbandingan = pd.DataFrame({\n",
        "    \"Model\": [\n",
        "        \"AR(1)-GARCH(1,1)\",\n",

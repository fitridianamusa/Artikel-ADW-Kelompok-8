        "\n",
        "# Data aktual testing\n",
        "harga_test = data.loc[\n",
        "    data[\"Tanggal\"] >= batas_tanggal,\n",
        "    [\"Tanggal\", \"Terakhir\"]\n",
        "].reset_index(drop=True)\n",
        "\n",
        "# Harga terakhir training\n",
        "harga_terakhir_train = data.loc[\n",
        "    data[\"Tanggal\"] < batas_tanggal,\n",
        "    \"Terakhir\"\n",
        "].iloc[-1]\n",
        "\n",
        "# Harga aktual periode sebelumnya\n",
        "harga_sebelumnya = np.concatenate([\n",
        "    [harga_terakhir_train],\n",
        "    harga_test[\"Terakhir\"].iloc[:-1].to_numpy()\n",
        "])\n",
        "\n",
        "# Prediksi harga one-step-ahead\n",
        "prediksi_harga = (\n",
        "    harga_sebelumnya *\n",
        "    np.exp(prediksi_return / 100)\n",
        ")\n",

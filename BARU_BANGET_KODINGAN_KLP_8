        "# ============================================\n",
        "# 8. FORECASTING AR(1)-GARCH(1,1)\n",
        "# ROLLING ONE-STEP-AHEAD\n",
        "# PERBAIKAN FAKTOR SKALA\n",
        "# ============================================\n",
        "\n",
        "# Mengambil model hasil estimasi training\n",
        "model_final = hasil_garch_kandidat[\"GARCH(1,1)\"]\n",
        "\n",
        "# Mengambil parameter hasil estimasi\n",
        "parameter_final = model_final.params\n",
        "\n",
        "# Mengambil faktor skala model\n",
        "scale = model_final.model.scale\n",
        "\n",
        "print(\"Faktor skala model:\", scale)\n",
        "\n",
        "# Mengubah data ke skala yang sama dengan estimasi model\n",
        "riwayat_return_scaled = r_train * scale\n",
        "\n",
        "# Menyimpan hasil forecasting\n",
        "prediksi_return = []\n",
        "prediksi_varians = []\n",
        "\n",
        "# Proses rolling one-step-ahead\n",
        "for i in range(len(r_test)):\n",
        "\n",
        "    # Membentuk model dengan data yang sudah diskalakan\n",
        "    model_step = arch_model(\n",
        "        riwayat_return_scaled,\n",
        "        mean=\"AR\",\n",
        "        lags=1,\n",
        "        vol=\"GARCH\",\n",
        "        p=1,\n",
        "        q=1,\n",
        "        dist=\"normal\",\n",
        "        rescale=False\n",
        "    )\n",
        "\n",
        "    # Menggunakan parameter tetap hasil estimasi training\n",
        "    hasil_step = model_step.fix(\n",
        "        parameter_final.to_numpy()\n",
        "    )\n",
        "\n",
        "    # Forecast satu periode ke depan\n",
        "    forecast_step = hasil_step.forecast(\n",
        "        horizon=1,\n",
        "        reindex=False\n",
        "    )\n",
        "\n",
        "    # Prediksi dalam skala estimasi\n",
        "    return_scaled = forecast_step.mean.iloc[-1, 0]\n",
        "    variance_scaled = forecast_step.variance.iloc[-1, 0]\n",
        "\n",
        "    # Mengembalikan prediksi ke skala log return asli\n",
        "    return_pred = return_scaled / scale\n",
        "    variance_pred = variance_scaled / (scale ** 2)\n",
        "\n",
        "    # Menyimpan hasil\n",
        "    prediksi_return.append(return_pred)\n",
        "    prediksi_varians.append(variance_pred)\n",
        "\n",
        "    # Memasukkan observasi aktual setelah ramalan dibuat\n",
        "    return_aktual_scaled = r_test.iloc[i] * scale\n",
        "\n",
        "    riwayat_return_scaled = pd.concat([\n",
        "        riwayat_return_scaled,\n",
        "        pd.Series(\n",
        "            [return_aktual_scaled],\n",
        "            index=[r_test.index[i]]\n",
        "        )\n",
        "    ])\n",
        "\n",
        "# Mengubah hasil menjadi array\n",
        "prediksi_return = np.array(prediksi_return)\n",
        "prediksi_varians = np.array(prediksi_varians)\n",
        "\n",
        "# Menghitung volatilitas dalam skala asli\n",
        "prediksi_volatilitas = np.sqrt(prediksi_varians)\n",
        "\n",
        "print(\"\\nFORECASTING SELESAI\")\n",
        "print(\"Jumlah ramalan:\", len(prediksi_return))\n",
        "print(\"Jumlah estimasi ulang parameter: 0\")\n",
        "\n",
        "print(\"\\nRingkasan prediksi log return:\")\n",
        "print(pd.Series(prediksi_return).describe())"

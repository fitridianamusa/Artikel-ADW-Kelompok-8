        "# ============================================\n",
        "# 9. EVALUASI HASIL FORECASTING\n",
        "# AR(1)-GARCH(1,1)\n",
        "# ============================================\n",
        "\n",
        "from sklearn.metrics import (\n",
        "    mean_squared_error,\n",
        "    mean_absolute_error,\n",
        "    mean_absolute_percentage_error\n",
        ")\n",
        "\n",
        "# Mengambil nilai aktual dan prediksi harga\n",
        "y_actual = tabel_forecast[\"Harga_Aktual\"].to_numpy()\n",
        "y_pred = tabel_forecast[\"Prediksi_Harga\"].to_numpy()\n",
        "\n",
        "# Menghitung metrik evaluasi\n",
        "rmse = np.sqrt(mean_squared_error(y_actual, y_pred))\n",
        "mae = mean_absolute_error(y_actual, y_pred)\n",
        "mape = mean_absolute_percentage_error(y_actual, y_pred) * 100\n",
        "\n",
        "# Membuat tabel evaluasi\n",
        "hasil_evaluasi = pd.DataFrame({\n",
        "    \"Model\": [\"AR(1)-GARCH(1,1)\"],\n",
        "    \"RMSE\": [rmse],\n",
        "    \"MAE\": [mae],\n",
        "    \"MAPE (%)\": [mape]\n",
        "})\n",
        "\n",
        "print(\"HASIL EVALUASI FORECASTING\")\n",
        "display(hasil_evaluasi.round(5))"
      ],

        "# ============================================\n",
        "# 9. KONVERSI PREDIKSI LOG RETURN KE HARGA\n",
        "# HYBRID GARCH-LSTM\n",
        "# ============================================\n",
        "\n",
        "# Mengambil harga aktual data testing\n",
        "harga_aktual_hybrid = test[\"Terakhir\"].to_numpy()\n",
        "\n",
        "# Mengambil harga aktual terakhir training\n",
        "harga_terakhir_train_hybrid = train[\"Terakhir\"].iloc[-1]\n",
        "\n",
        "# Membentuk harga aktual periode sebelumnya\n",
        "harga_sebelumnya_hybrid = np.concatenate([\n",
        "    [harga_terakhir_train_hybrid],\n",
        "    harga_aktual_hybrid[:-1]\n",
        "])\n",
        "\n",
        "# Konversi prediksi GARCH menjadi harga\n",
        "pred_harga_garch_hybrid = (\n",
        "    harga_sebelumnya_hybrid *\n",
        "    np.exp(np.array(pred_garch_hybrid) / 100)\n",
        ")\n",
        "\n",
        "# Konversi prediksi hybrid menjadi harga\n",
        "pred_harga_hybrid = (\n",
        "    harga_sebelumnya_hybrid *\n",
        "    np.exp(pred_return_hybrid / 100)\n",
        ")\n",
        "\n",
        "# Membentuk tabel hasil forecasting\n",
        "hasil_hybrid[\"Harga_Aktual\"] = harga_aktual_hybrid\n",
        "\n",
        "hasil_hybrid[\"Prediksi_Harga_GARCH\"] = (\n",
        "    pred_harga_garch_hybrid\n",
        ")\n",
        "\n",
        "hasil_hybrid[\"Prediksi_Harga_Hybrid\"] = (\n",
        "    pred_harga_hybrid\n",
        ")\n",
        "\n",
        "# Mengatur urutan kolom\n",
        "hasil_hybrid = hasil_hybrid[\n",
        "    [\n",
        "        \"Tanggal\",\n",
        "        \"Harga_Aktual\",\n",
        "        \"Aktual_Log_Return\",\n",
        "        \"Prediksi_GARCH\",\n",
        "        \"Prediksi_Residual_LSTM\",\n",
        "        \"Prediksi_Hybrid\",\n",
        "        \"Prediksi_Harga_GARCH\",\n",
        "        \"Prediksi_Harga_Hybrid\"\n",
        "    ]\n",
        "]\n",
        "\n",
        "print(\"HASIL KONVERSI PREDIKSI HYBRID KE HARGA\")\n",

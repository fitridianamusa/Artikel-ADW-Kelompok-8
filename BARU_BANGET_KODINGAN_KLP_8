        "# ============================================\n",
        "# 4. EVALUASI RESIDUAL MEAN MODEL\n",
        "# ============================================\n",
        "\n",
        "from statsmodels.stats.diagnostic import (\n",
        "    acorr_ljungbox,\n",
        "    het_arch\n",
        ")\n",
        "\n",
        "hasil_diagnostik = []\n",
        "\n",
        "# Kandidat yang dipertahankan\n",
        "kandidat_mean = [\"AR(1)\", \"MA(1)\"]\n",
        "\n",
        "for nama in kandidat_mean:\n",
        "\n",
        "    # Mengambil residual\n",
        "    residual = hasil_model[nama].resid.dropna()\n",
        "\n",
        "    # Uji Ljung-Box pada lag 10 dan 20\n",
        "    lb = acorr_ljungbox(\n",
        "        residual,\n",
        "        lags=[10, 20],\n",
        "        return_df=True\n",
        "    )\n",
        "\n",
        "    # Uji ARCH-LM dengan 10 lag\n",
        "    arch_lm = het_arch(\n",
        "        residual,\n",
        "        nlags=10\n",
        "    )\n",
        "\n",
        "    hasil_diagnostik.append({\n",
        "        \"Model\": nama,\n",
        "        \"LB Lag 10\": lb.loc[10, \"lb_pvalue\"],\n",
        "        \"LB Lag 20\": lb.loc[20, \"lb_pvalue\"],\n",
        "        \"ARCH-LM Statistic\": arch_lm[0],\n",
        "        \"ARCH-LM P-value\": arch_lm[1]\n",
        "    })\n",
        "\n",
        "# Membuat tabel hasil diagnostik\n",
        "tabel_diagnostik = pd.DataFrame(hasil_diagnostik)\n",
        "\n",
        "print(\"HASIL DIAGNOSTIK RESIDUAL MEAN MODEL\")\n",
        "display(tabel_diagnostik.round(5))"

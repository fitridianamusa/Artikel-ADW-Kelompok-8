        "# ============================================\n",
        "# 10. ESTIMASI FINAL AR(1)-GARCH(1,1)\n",
        "# MENGGUNAKAN SELURUH DATA AKTUAL\n",
        "# ============================================\n",
        "\n",
        "from arch import arch_model\n",
        "\n",
        "r_all = data_return[\"Log_Return\"].dropna()\n",
        "\n",
        "model_final = arch_model(\n",
        "    r_all,\n",
        "    mean=\"AR\",\n",
        "    lags=1,\n",
        "    vol=\"GARCH\",\n",
        "    p=1,\n",
        "    q=1,\n",
        "    dist=\"normal\",\n",
        "    rescale=True\n",
        ")\n",
        "\n",
        "hasil_final = model_final.fit(disp=\"off\")\n",
        "\n",
        "print(hasil_final.summary())\n",
        "\n",
        "print(\"\\nJumlah observasi:\", len(r_all))\n",
        "print(\"Tanggal awal:\", data_return[\"Tanggal\"].min())\n",
        "print(\"Tanggal akhir:\", data_return[\"Tanggal\"].max())\n",
        "print(\"Faktor skala:\", hasil_final.model.scale)"

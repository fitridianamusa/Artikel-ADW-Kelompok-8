        "# ============================================\n",
        "# 13. FORECASTING 7 PERIODE KE DEPAN\n",
        "# RECURSIVE LSTM\n",
        "# ============================================\n",
        "\n",
        "# Menentukan horizon forecasting\n",
        "horizon = 7\n",
        "\n",
        "# Mengambil 10 observasi terakhir sebagai input awal\n",
        "last_sequence_lstm = all_scaled_lstm[-lookback:].reshape(\n",
        "    1, lookback, 1\n",
        ")\n",
        "\n",
        "# Menampung hasil prediksi\n",
        "pred_scaled_future_lstm = []\n",
        "\n",
        "# Proses forecasting rekursif\n",
        "for i in range(horizon):\n",
        "\n",
        "    # Prediksi satu langkah ke depan\n",
        "    pred_scaled = model_lstm_final.predict(\n",
        "        last_sequence_lstm,\n",
        "        verbose=0\n",
        "    )\n",
        "\n",
        "    # Menyimpan prediksi\n",
        "    pred_scaled_future_lstm.append(\n",
        "        pred_scaled[0, 0]\n",
        "    )\n",
        "\n",
        "    # Memperbarui sekuens menggunakan hasil prediksi\n",
        "    last_sequence_lstm = np.concatenate(\n",
        "        [\n",
        "            last_sequence_lstm[:, 1:, :],\n",
        "            pred_scaled.reshape(1, 1, 1)\n",
        "        ],\n",
        "        axis=1\n",
        "    )\n",
        "\n",
        "# Mengembalikan prediksi ke skala log return asli\n",
        "pred_return_future_lstm = scaler_lstm_final.inverse_transform(\n",
        "    np.array(pred_scaled_future_lstm).reshape(-1, 1)\n",
        ").flatten()\n",
        "\n",
        "print(\"FORECASTING LSTM SELESAI\")\n",
        "print(\"Horizon:\", horizon)\n",
        "print(\"Jumlah ramalan:\", len(pred_return_future_lstm))\n",

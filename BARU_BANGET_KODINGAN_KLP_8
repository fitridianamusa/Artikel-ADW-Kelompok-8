        "# ============================================\n",
        "# 1. ESTIMASI AR(1)-GARCH(1,1)\n",
        "# UNTUK MODEL HYBRID\n",
        "# ============================================\n",
        "\n",
        "# Faktor skala yang sama dengan analisis GARCH\n",
        "scale_factor_hybrid = 10.0\n",
        "\n",
        "# Mengambil data training\n",
        "r_train_hybrid = r_train.astype(float).copy()\n",
        "\n",
        "# Mengalikan log return dengan faktor skala\n",
        "r_train_scaled_hybrid = (\n",
        "    r_train_hybrid * scale_factor_hybrid\n",
        ")\n",
        "\n",
        "# Membentuk model AR(1)-GARCH(1,1)\n",
        "model_garch_hybrid = arch_model(\n",
        "    r_train_scaled_hybrid,\n",
        "    mean=\"AR\",\n",
        "    lags=1,\n",
        "    vol=\"GARCH\",\n",
        "    p=1,\n",
        "    q=1,\n",
        "    dist=\"normal\",\n",
        "    rescale=False\n",
        ")\n",
        "\n",
        "# Estimasi parameter\n",
        "hasil_garch_hybrid = model_garch_hybrid.fit(\n",
        "    disp=\"off\"\n",

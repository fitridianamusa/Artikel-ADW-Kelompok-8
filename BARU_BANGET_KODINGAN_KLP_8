        "# ============================================\n",
        "# 11G. KONVERSI LOG RETURN MENJADI HARGA\n",
        "# ============================================\n",
        "\n",
        "# Mengambil tanggal dan harga terakhir\n",
        "data_sorted = data.sort_values(\n",
        "    \"Tanggal\"\n",
        ").reset_index(drop=True)\n",
        "\n",
        "tanggal_terakhir = data_sorted[\"Tanggal\"].iloc[-1]\n",
        "\n",
        "harga_terakhir = float(\n",
        "    data_sorted[\"Terakhir\"].iloc[-1]\n",
        ")\n",
        "\n",
        "# Membuat tanggal forecasting\n",
        "tanggal_future = pd.bdate_range(\n",
        "    start=tanggal_terakhir + pd.offsets.BDay(1),\n",
        "    periods=horizon\n",
        ")\n",
        "\n",
        "# Menghitung prediksi harga secara rekursif\n",
        "prediksi_harga_future = []\n",
        "\n",
        "harga_sebelumnya = harga_terakhir\n",
        "\n",
        "for r in prediksi_hybrid_future:\n",
        "\n",
        "    harga_prediksi = (\n",
        "        harga_sebelumnya * np.exp(r / 100)\n",
        "    )\n",
        "\n",
        "    prediksi_harga_future.append(harga_prediksi)\n",
        "\n",
        "    harga_sebelumnya = harga_prediksi\n",
        "\n",
        "\n",
        "# Membentuk tabel akhir\n",
        "tabel_forecast_hybrid = pd.DataFrame({\n",
        "    \"Tanggal\": tanggal_future,\n",
        "    \"Horizon\": range(1, horizon + 1),\n",
        "    \"Prediksi_Log_Return_GARCH\": prediksi_garch_future,\n",
        "    \"Prediksi_Residual_LSTM\": prediksi_residual_future,\n",
        "    \"Prediksi_Log_Return_Hybrid\": prediksi_hybrid_future,\n",
        "    \"Prediksi_Varians\": prediksi_varians_future,\n",
        "    \"Prediksi_Volatilitas\": prediksi_volatilitas_future,\n",
        "    \"Prediksi_Harga\": prediksi_harga_future\n",
        "})\n",
        "\n",
        "print(\"HASIL FORECASTING HYBRID GARCH-LSTM 7 PERIODE KE DEPAN\")\n",
        "\n",
        "display(tabel_forecast_hybrid.round(6))"

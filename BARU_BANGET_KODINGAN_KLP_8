      "source": [
        "# ============================================\n",
        "# 11. FORECASTING 7 PERIODE KE DEPAN\n",
        "# RECURSIVE ONE-STEP-AHEAD\n",
        "# AR(1)-GARCH(1,1)\n",
        "# ============================================\n",
        "\n",
        "# Menentukan horizon forecasting\n",
        "horizon = 7\n",
        "\n",
        "# Mengambil faktor skala model\n",
        "scale = hasil_final.model.scale\n",
        "\n",
        "# Forecast 7 langkah ke depan\n",
        "forecast_final = hasil_final.forecast(\n",
        "    horizon=horizon,\n",
        "    reindex=False\n",
        ")\n",
        "\n",
        "# Mengambil prediksi mean dalam skala model\n",
        "mean_scaled = forecast_final.mean.iloc[-1].to_numpy()\n",
        "\n",
        "# Mengambil prediksi varians dalam skala model\n",
        "variance_scaled = forecast_final.variance.iloc[-1].to_numpy()\n",
        "\n",
        "# Mengembalikan ke skala log return asli\n",
        "prediksi_return_future = mean_scaled / scale\n",
        "\n",
        "prediksi_varians_future = (\n",
        "    variance_scaled / (scale ** 2)\n",
        ")\n",
        "\n",
        "# Menghitung volatilitas\n",
        "prediksi_volatilitas_future = np.sqrt(\n",
        "    prediksi_varians_future\n",
        ")\n",
        "\n",
        "print(\"FORECASTING SELESAI\")\n",
        "print(\"Horizon:\", horizon)\n",
        "print(\"Faktor skala:\", scale)"
      ],

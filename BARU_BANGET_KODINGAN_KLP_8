        "# ============================================\n",
        "# 6. DIAGNOSTIK MODEL AR(1)-GARCH(1,1)\n",
        "# ============================================\n",
        "\n",
        "from statsmodels.stats.diagnostic import (\n",
        "    acorr_ljungbox,\n",
        "    het_arch\n",
        ")\n",
        "\n",
        "# Mengambil model GARCH(1,1)\n",
        "model_final_sementara = hasil_garch_kandidat[\"GARCH(1,1)\"]\n",
        "\n",
        "# Mengambil residual terstandarisasi\n",
        "resid_std = model_final_sementara.std_resid.dropna()\n",
        "\n",
        "# 1. Ljung-Box residual terstandarisasi\n",
        "lb_resid = acorr_ljungbox(\n",
        "    resid_std,\n",
        "    lags=[10, 20],\n",
        "    return_df=True\n",
        ")\n",
        "\n",
        "# 2. Ljung-Box kuadrat residual terstandarisasi\n",
        "lb_resid_sq = acorr_ljungbox(\n",
        "    resid_std**2,\n",
        "    lags=[10, 20],\n",
        "    return_df=True\n",
        ")\n",
        "\n",
        "# 3. ARCH-LM residual terstandarisasi\n",
        "arch_test = het_arch(\n",
        "    resid_std,\n",
        "    nlags=10\n",
        ")\n",
        "\n",
        "# Membuat tabel hasil\n",
        "hasil_diagnostik_garch = pd.DataFrame({\n",
        "    \"Pengujian\": [\n",
        "        \"Ljung-Box Residual Lag 10\",\n",
        "        \"Ljung-Box Residual Lag 20\",\n",
        "        \"Ljung-Box Kuadrat Residual Lag 10\",\n",
        "        \"Ljung-Box Kuadrat Residual Lag 20\",\n",
        "        \"ARCH-LM\"\n",
        "    ],\n",
        "    \"Statistik\": [\n",
        "        lb_resid.loc[10, \"lb_stat\"],\n",
        "        lb_resid.loc[20, \"lb_stat\"],\n",
        "        lb_resid_sq.loc[10, \"lb_stat\"],\n",
        "        lb_resid_sq.loc[20, \"lb_stat\"],\n",
        "        arch_test[0]\n",
        "    ],\n",
        "    \"P-value\": [\n",
        "        lb_resid.loc[10, \"lb_pvalue\"],\n",
        "        lb_resid.loc[20, \"lb_pvalue\"],\n",
        "        lb_resid_sq.loc[10, \"lb_pvalue\"],\n",
        "        lb_resid_sq.loc[20, \"lb_pvalue\"],\n",
        "        arch_test[1]\n",
        "    ]\n",
        "})\n",
        "\n",
        "print(\"HASIL DIAGNOSTIK MODEL AR(1)-GARCH(1,1)\")\n",
        "display(hasil_diagnostik_garch.round(5))"
      ],

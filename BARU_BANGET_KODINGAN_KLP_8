        "# ============================================\n",
        "# 3. PEMBENTUKAN SEKUENS LSTM\n",
        "# LOOKBACK = 10\n",
        "# ============================================\n",
        "\n",
        "# Menentukan panjang lookback\n",
        "lookback = 10\n",
        "\n",
        "# --------------------------------------------\n",
        "# A. MEMBENTUK SEKUENS TRAINING\n",
        "# --------------------------------------------\n",
        "\n",
        "X_train_lstm = []\n",
        "y_train_lstm = []\n",
        "\n",
        "for i in range(lookback, len(train_scaled)):\n",
        "\n",
        "    X_train_lstm.append(\n",
        "        train_scaled[i-lookback:i, 0]\n",
        "    )\n",
        "\n",
        "    y_train_lstm.append(\n",
        "        train_scaled[i, 0]\n",
        "    )\n",
        "\n",
        "# Mengubah ke array NumPy\n",
        "X_train_lstm = np.array(X_train_lstm)\n",
        "y_train_lstm = np.array(y_train_lstm)\n",
        "\n",
        "\n",
        "# --------------------------------------------\n",
        "# B. MEMBENTUK SEKUENS TESTING\n",
        "# --------------------------------------------\n",
        "\n",
        "# Menggabungkan 10 observasi terakhir training\n",
        "# dengan seluruh observasi testing\n",
        "\n",
        "test_input = np.concatenate([\n",
        "    train_scaled[-lookback:],\n",
        "    test_scaled\n",
        "])\n",
        "\n",
        "X_test_lstm = []\n",
        "y_test_lstm = []\n",
        "\n",
        "for i in range(lookback, len(test_input)):\n",
        "\n",
        "    X_test_lstm.append(\n",
        "        test_input[i-lookback:i, 0]\n",
        "    )\n",
        "\n",
        "    y_test_lstm.append(\n",
        "        test_input[i, 0]\n",
        "    )\n",
        "\n",
        "# Mengubah ke array NumPy\n",
        "X_test_lstm = np.array(X_test_lstm)\n",
        "y_test_lstm = np.array(y_test_lstm)\n",
        "\n",
        "\n",
        "# --------------------------------------------\n",
        "# C. MENAMBAHKAN DIMENSI FITUR\n",
        "# --------------------------------------------\n",
        "\n",
        "X_train_lstm = X_train_lstm.reshape(\n",
        "    X_train_lstm.shape[0],\n",
        "    X_train_lstm.shape[1],\n",
        "    1\n",
        ")\n",
        "\n",
        "X_test_lstm = X_test_lstm.reshape(\n",
        "    X_test_lstm.shape[0],\n",
        "    X_test_lstm.shape[1],\n",
        "    1\n",
        ")\n",
        "\n",
        "\n",
        "# --------------------------------------------\n",
        "# D. PEMERIKSAAN HASIL\n",
        "# --------------------------------------------\n",
        "\n",
        "print(\"HASIL PEMBENTUKAN SEKUENS LSTM\")\n",
        "\n",
        "print(\"\\nParameter:\")\n",
        "print(\"Lookback:\", lookback)\n",
        "\n",
        "print(\"\\nUkuran data:\")\n",
        "print(\"X_train:\", X_train_lstm.shape)\n",
        "print(\"y_train:\", y_train_lstm.shape)\n",
        "print(\"X_test :\", X_test_lstm.shape)\n",
        "print(\"y_test :\", y_test_lstm.shape)\n",
        "\n",
        "print(\"\\nJumlah sekuens:\")\n",
        "print(\"Training:\", len(X_train_lstm))\n",
        "print(\"Testing :\", len(X_test_lstm))\n",
        "\n",
        "print(\"\\nLima target pertama training:\")\n",
        "display(pd.DataFrame({\n",
        "    \"Target_Training\": y_train_lstm[:5]\n",
        "}))\n",
        "\n",
        "print(\"\\nLima target pertama testing:\")\n",
        "display(pd.DataFrame({\n",
        "    \"Target_Testing\": y_test_lstm[:5]\n",
        "}))"

        "# ============================================\n",
        "# 13B. VISUALISASI PERBANDINGAN FORECASTING\n",
        "# ============================================\n",
        "\n",
        "plt.figure(figsize=(14, 6))\n",
        "\n",
        "# Data aktual 30 observasi terakhir\n",
        "data_plot = data.sort_values(\n",
        "    \"Tanggal\"\n",
        ").tail(30)\n",
        "\n",
        "plt.plot(\n",
        "    data_plot[\"Tanggal\"],\n",
        "    data_plot[\"Terakhir\"],\n",
        "    label=\"Harga Aktual\",\n",
        "    linewidth=2\n",
        ")\n",
        "\n",
        "# Tanggal dan harga aktual terakhir\n",
        "tanggal_terakhir = pd.to_datetime(\n",
        "    data[\"Tanggal\"].iloc[-1]\n",
        ")\n",
        "\n",
        "harga_terakhir = float(\n",
        "    data[\"Terakhir\"].iloc[-1]\n",
        ")\n",
        "\n",
        "# Menggabungkan titik awal dengan tanggal forecasting\n",
        "tanggal_garis = pd.concat([\n",
        "    pd.Series([tanggal_terakhir]),\n",
        "    perbandingan_forecast[\"Tanggal\"]\n",
        "])\n",
        "\n",
        "\n",
        "# Forecast GARCH\n",
        "harga_garch = np.concatenate([\n",
        "    [harga_terakhir],\n",
        "    perbandingan_forecast[\"Forecast_GARCH\"].to_numpy()\n",
        "])\n",
        "\n",
        "plt.plot(\n",
        "    tanggal_garis,\n",
        "    harga_garch,\n",
        "    linestyle=\"-\",\n",
        "    linewidth=1.8,\n",
        "    label=\"AR(1)-GARCH(1,1)\"\n",
        ")\n",
        "\n",
        "\n",
        "# Forecast LSTM\n",
        "harga_lstm = np.concatenate([\n",
        "    [harga_terakhir],\n",
        "    perbandingan_forecast[\"Forecast_LSTM\"].to_numpy()\n",
        "])\n",
        "\n",
        "plt.plot(\n",
        "    tanggal_garis,\n",
        "    harga_lstm,\n",
        "    linestyle=\"-\",\n",
        "    linewidth=1.8,\n",
        "    label=\"LSTM\"\n",
        ")\n",
        "\n",
        "\n",
        "# Forecast Hybrid\n",
        "harga_hybrid = np.concatenate([\n",
        "    [harga_terakhir],\n",
        "    perbandingan_forecast[\"Forecast_Hybrid\"].to_numpy()\n",
        "])\n",
        "\n",
        "plt.plot(\n",
        "    tanggal_garis,\n",
        "    harga_hybrid,\n",
        "    linestyle=\"-\",\n",
        "    linewidth=2,\n",
        "    label=\"Hybrid GARCH-LSTM\"\n",
        ")\n",
        "\n",
